# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# FIREBASE WEB PUSH (FCM VAPID KEY):
VITE_FIREBASE_VAPID_KEY="YOUR_FIREBASE_WEB_PUSH_VAPID_KEY_HERE"

# LOCAL FIREBASE EMULATOR SUITE (Set to "true" in local testing only):
VITE_USE_EMULATORS="false"

# ONESIGNAL FREE WEB PUSH (Works 100% Free on Spark Plan without Cloud Functions):
# 1. Sign up at https://onesignal.com
# 2. Create App: "Al Tawoos ERP" -> Select "Web Push"
# 3. Copy App ID and REST API Key from Settings -> Keys & IDs:
VITE_ONESIGNAL_APP_ID=""
VITE_ONESIGNAL_REST_API_KEY=""
